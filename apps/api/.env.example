# 12 Circle API — environment configuration template.
# Copy to apps/api/.env and fill in. .env is gitignored; never commit real values.
#
# Resolved and validated in src/config/api-config.ts. `npm start` logs a
# redacted summary at boot and warns about anything required that is missing.

# Which environment this process serves: dev | qa | prod.
# APP_ENV is authoritative; NODE_ENV is only a fallback. An unknown value is a
# hard error rather than a silent default.
APP_ENV=dev

PORT=3000

# Comma-separated browser origins allowed to call the API.
# Empty reflects any origin — acceptable for local dev only.
CORS_ORIGINS=

# ── Secrets — server-side only, never shipped to the Flutter client ──────────

# Signing secret for the API's own JWTs (register/login).
JWT_SECRET=

# Supabase project URL for this environment (informational).
SUPABASE_URL=

# Supabase JWT signing secret, from Supabase Dashboard →
# Project Settings → API → JWT Settings → JWT Secret.
# Used to verify the access tokens the Flutter client sends. Without it the AI
# endpoints fail closed with 503 rather than accepting unverified callers.
SUPABASE_JWT_SECRET=

# Anthropic API key powering the AI Nutrition Coach.
# THE ONLY PLACE THIS MAY LIVE. It is never returned in a response, never
# logged, and never present in a Flutter build
# (see apps/mobile/tool/check_web_build_secrets.sh).
ANTHROPIC_API_KEY=

# ── Optional AI tuning ───────────────────────────────────────────────────────

# Defaults to claude-sonnet-4-6 — the model the Flutter client used before the
# integration moved server-side.
ANTHROPIC_MODEL=

# Defaults to 1024, matching the previous client-side limit.
ANTHROPIC_MAX_TOKENS=
